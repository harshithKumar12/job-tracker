# --- Required for live (IMAP) mode ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_FOLDER=INBOX
IMAP_DAYS_BACK=60

# --- Required for Gemini-powered steps (status inference + follow-up drafts) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Leave blank to auto-discover a model, or pin a model available to your account.
GEMINI_MODEL=

# --- Monitoring ---
# Set to "true" to enable scheduled re-runs via `python -m agent_job_tracker.monitor`
MONITORING_ENABLED=false
# How often (in minutes) the monitor re-runs the pipeline
MONITORING_INTERVAL_MINUTES=60
# Where run logs + alerts are appended (JSONL)
MONITORING_LOG_FILE=./monitoring/runs.jsonl
# Business-day threshold that triggers a follow-up alert
MONITORING_ALERT_DAYS=10
